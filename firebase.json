{
  "hosting": {
    "site": "udar-atma",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "api/**",
      "package.json",
      "package-lock.json",
      ".github/**"
    ],
    "rewrites": [
      {
        "source": "/download",
        "destination": "/download.html"
      },
      {
        "source": "/download/",
        "destination": "/download.html"
      }
    ],
    "headers": [
      {
        "source": "/download.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
